<odoo>
    <data>
        <record model="ir.ui.view" id="specialty_specialty_form_view">
            <field name="name">medical.specialty.form</field>
            <field name="model">medical.specialty</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group>
                            <field name="code"/>
                            <field name="specialty_type"/>
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="specialty_specialty_tree_view">
            <field name="name">medical.specialty.tree</field>
            <field name="model">medical.specialty</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="specialty_type"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="specialty_specialty_search_view">
            <field name="name">medical.specialty.search</field>
            <field name="model">medical.specialty</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>
<!-- Kanban view -->
        <record model="ir.actions.act_window" id="specialty_specialty_action">
            <field name="name">Specialties</field>
            <field name="res_model">medical.specialty</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first specialty
                </p>
            </field>
        </record>
    </data>
</odoo>
