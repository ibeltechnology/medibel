<odoo>
    <data>
        <record model="ir.ui.view" id="patient_range_form_view">
            <field name="name">patient.age.range.form</field>
            <field name="model">patient.age.range</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <label for="age_from"/>
                                <div class="o_row">
                                    <field name="age_from"/><span>days</span>
                                </div>
                            </group>
                            <group>
                                <label for="age_to"/>
                                <div class="o_row">
                                    <field name="age_to"/><span>days</span>
                                </div>
                            <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="patient_range_tree_view">
            <field name="name">patient.age.range.tree</field>
            <field name="model">patient.age.range</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="age_from" />
                    <field name="age_to" />
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="patient_range_search_view">
            <field name="name">patient.age.range.search</field>
            <field name="model">patient.age.range</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="patient_range_action">
            <field name="name">Age Range</field>
            <field name="res_model">patient.age.range</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="search_view_id" ref="patient_range_search_view"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first age range
                </p>
            </field>
        </record>
        
    </data>
</odoo>
