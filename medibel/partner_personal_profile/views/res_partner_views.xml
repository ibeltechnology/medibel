<odoo>
  <record id="view_partner_form_personal_profile" model="ir.ui.view">
    <field name="name">res.partner.form.personal.profile</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Personal Profile" invisible="is_company">
          <group>
            <group string="Identity">
              <label for="barcode"/>
              <div class="o_row">
                <field name="barcode" />
                  <button string="Generate" class="btn btn-link" type="object" name="generate_random_barcode" invisible="barcode"/>
              </div>
              <field name="date_of_birth"/>
              <field name="age_display" readonly="1"/>
              <field name="age_days" invisible="1"/>
              <field name="gender_id"/>
              <field name="marital_status"/>
              <field name="nationality_id"/>
            </group>
            <group string="Location">
              <field name="patient_country_id"/>
              <field name="region_id"/>
              <field name="departement_id"/>
              <field name="arrondissement_id"/>
              <field name="commune_id"/>
            </group>
          </group>

          <group>
            <group string="Identity Document">
              <field name="id_type"/>
              <field name="id_number"/>
              <field name="id_issue_date"/>
              <field name="id_expiry_date"/>
            </group>
            <group string="Emergency">
              <field name="emergency_contact_id" options="{'no_create_edit': True}"/>
              <field name="emergency_phone"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
