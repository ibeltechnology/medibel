<odoo>
  <record id="medical_pathology_form_view" model="ir.ui.view">
    <field name="name">medical.pathology.form.view</field>
    <field name="model">medical.pathology</field>
    <field name="inherit_id" ref="medical_pathology.medical_pathology_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='category_id']" position="after">
        <field name="age_range_ids" widget="many2many_tags"/>
      </xpath>
    </field>
  </record>

  <record id="patient_range_form_view" model="ir.ui.view">
    <field name="name">patient.range.form.view</field>
    <field name="model">patient.age.range</field>
    <field name="inherit_id" ref="partner_personal_profile.patient_range_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Pathologies">
          <field name="pathology_ids"/>
        </page> 
      </xpath>
    </field>
  </record>
</odoo>

