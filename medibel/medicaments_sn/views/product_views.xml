<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_insert_fields" model="ir.ui.view">
        <field name="name">product.template.form.inherit.insert.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="dci_id" invisible="is_medicament==False"/>
            </xpath>
            <xpath expr="//field[@name='is_storable']" position="after">
                <field name="is_medicament"/>
            </xpath>
        </field>
    </record>
</odoo>
