<?xml version="1.0" encoding="utf-8"?>
<odoo>   
    <data>
        <record model="ir.ui.view" id="consultation_consultation_evaluation_form_view">
            <field name="name">consultation.evaluation.form</field>
            <field name="model">consultation.evaluation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group>
                             <field name="active" invisible="1"/>
                        </group>
                        
                        <notebook>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="consultation_consultation_evaluation_list_view">
            <field name="name">consultation.evaluation.list</field>
            <field name="model">consultation.evaluation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="consultation_consultation_evaluation_search_view">
            <field name="name">consultation.evaluation.search</field>
            <field name="model">consultation.evaluation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>
<!-- Kanban view -->
        <record model="ir.actions.act_window" id="consultation_consultation_evaluation_action">
            <field name="name">Consultations</field>
            <field name="res_model">consultation.evaluation</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="view_id" ref="consultation_consultation_evaluation_list_view"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first
                </p>
            </field>
        </record>
        <menuitem id="consultation_consultation_evaluation_menu_action" action="consultation_consultation_evaluation_action" name="Evaluations" parent="consultation_top_menu_consultations" sequence="1"/>
    </data>
</odoo>
