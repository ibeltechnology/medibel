<odoo>
    <data>
        <record id="category_consultation" model="ir.module.category">
            <field name="name">Consultation</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_privilege_consultation">
            <field name="name">Consultation</field>
            <field name="category_id" ref="category_consultation"/>
            <field name="sequence">7</field>
        </record>
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_consultation" />
            <field name="comment">Allowed to use</field>
        </record>
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_consultation" />
            <field name="implied_ids" eval="[(4, ref('group_user'))]" />
            <field name="comment">Allowed to manage configurations</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
</odoo>
