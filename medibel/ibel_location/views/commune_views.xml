<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="commune_form_view" model="ir.ui.view">
            <field name="name">commune.form.view</field>
            <field name="model">commune.commune</field>
            <field name="arch" type="xml">
                <form string="Commune">
                    <sheet>
                        <div name="button_box" class="oe_button_box" >
                        </div>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group colspan="4" col="4">
                            <field name="region_id"/>
                            <field name="departement_id" />
                            <field name="arrondissement_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="commune_tree_view" model="ir.ui.view">
            <field name="name">commune.tree.view</field>
            <field name="model">commune.commune</field>
            <field name="arch" type="xml">
                <list string="Communes">
                    <field name="name"/>
                    <field name="region_id"/>
                    <field name="departement_id"/>
                    <field name="arrondissement_id" />
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="commune_search_view">
            <field name="name">commune.commune.search</field>
            <field name="model">commune.commune</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter name="by_region" string="Region" context="{'group_by': 'region_id'}"/>
                    <filter name="by_departement" string="Département" context="{'group_by': 'departement_id'}"/>
                    <filter name="by_arrondissement" string="Arrondissement" context="{'group_by': 'arrondissement_id'}"/>
                </search>
            </field>
        </record>
        <record id="action_commune" model="ir.actions.act_window">
            <field name="name">Communes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">commune.commune</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
