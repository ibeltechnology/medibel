<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="arrondissement_form_view" model="ir.ui.view">
            <field name="name">arrondissement.form.view</field>
            <field name="model">arrondissement.arrondissement</field>
            <field name="arch" type="xml">
                <form string="arrondissement">
                    <sheet>
                        <div name="button_box" class="oe_button_box" >
                            <button name="get_region_id_commune_ids" type="object" class="oe_stat_button" icon="fa-building">
                                <div class="o_stat_info">
                                    <field name="commune_ids_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Communes</span>
                                </div>
                            </button>
                        </div>
                         <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group colspan="4" col="4">
                            <field name="region_id"/>       
                            <field name="departement_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="arrondissement_tree_view" model="ir.ui.view">
            <field name="name">arrondissement.tree.view</field>
            <field name="model">arrondissement.arrondissement</field>
            <field name="arch" type="xml">
                <list string="arrondissement">
                    <field name="name"/>
                    <field name="departement_id"/>
                    <field name="region_id"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="arrondissement_search_view">
            <field name="name">arrondissement.arrondissement.search</field>
            <field name="model">arrondissement.arrondissement</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter name="by_region" string="Region" context="{'group_by': 'region_id'}"/>
                   <filter name="by_departement" string="Département" context="{'group_by': 'departement_id'}"/>
                </search>
            </field>
        </record>
        <record id="action_arrondissement" model="ir.actions.act_window">
            <field name="name">arrondissement</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">arrondissement.arrondissement</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
