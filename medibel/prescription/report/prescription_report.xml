<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="prescription.prescription_order_report_template">
		    <t t-call="web.external_layout">
				    <div class="page">
					      <div class="oe_structure"/>
						    <h3 class="text-center mb32">
								    <strong>PRESCRIPTION ORDER</strong>
							  </h3>
					      <br/>

					      <table class="table table-borderless"> 
                    <tr> 
                        <th class="text-left">Identifiant :</th> 
                        <th class="text-left">Date de Préscription :</th>
                        <th class="text-left">Patient :</th>
                        <th class="text-left">Médecin Préscripteur :</th>
                    </tr> 
                    <tr> 
                        <td class="text-left"><span style="font-weight:normal;" t-field="doc.name"/></td> 
                        <td class="text-left"><span style="font-weight:normal;" t-field="doc.prescription_date"/></td>
                        <td class="text-left"><span style="font-weight:normal;" t-field="doc.patient_id"/></td>
                        <td class="text-left"><span style="font-weight:normal;" t-field="doc.doctor_id"/></td>
                    </tr>                       
                </table>					
				
                <div>
                    <t t-foreach="doc.prescription_line_ids" t-as="test">
                        <table class="table">
                            <thead>
                                <div>
                                    <h5><span t-field="test.medicament_id"/></h5>
                                </div>
                            </thead>
                            <tbody class="sale_tbody">
									              <tr t-if="test.frequency_id">
										                <td>
											                  <strong>Posologie</strong>
										                </td>
										                <td>
											                  <span t-field="test.short_comment"/>  <span t-field="test.frequency_id"/>
										                </td>
									              </tr>
									              <tr t-if="test.start_date">
										                <td>
											                  <strong>Date de début</strong>
										                </td>
										                <td>
											                  <span t-field="test.start_date"/>
										                </td>
								        	      </tr>
									              <tr t-if="test.end_date">
										                <td>
											                  <strong>Date d’arrêt</strong>
										                </td>
										                <td>
											                  <span t-field="test.end_date"/>
										                </td>
									              </tr>								
							              </tbody>
						            </table>
						        </t>
					      </div>
            </div>
        </t>
    </template>
    <template id="prescription_order_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="prescription.prescription_order_report_template" t-lang="user.lang"/>
            </t>
        </t>
    </template>
    <record id="prescription_order_report_action" model="ir.actions.report">
        <field name="name">Imprimer l'ordonnance</field>
        <field name="model">prescription.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">prescription.prescription_order_report</field>
        <field name="binding_model_id" ref="model_prescription_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
