<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_smart_button" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.smart.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_prescription"
                        icon="fa-article">
                    <field string="Prescriptions" name="prescription_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
