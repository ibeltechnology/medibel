<?xml version="1.0" encoding="utf-8"?>
<odoo>   
    <data>
        <record model="ir.ui.view" id="prescription_prescription_order_form_view">
            <field name="name">prescription.order.form</field>
            <field name="model">prescription.order</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1 class="mb32">
                                <field name="name" class="mb16"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="prescription_date"/>
                                <field name="patient_id"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="doctor_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Prescription lines">
                                <field name="prescription_line_ids">
                                    <list>
                                        <field name="medicament_id"/>
                                        <field name="frequency_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="prescription_prescription_order_list_view">
            <field name="name">prescription.order.list</field>
            <field name="model">prescription.order</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="prescription_date"/>
                    <field name="doctor_id"/>
                    <field name="patient_id"/>
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="prescription_prescription_order_search_view">
            <field name="name">prescription.order.search</field>
            <field name="model">prescription.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>
<!-- Kanban view -->
        <record model="ir.actions.act_window" id="prescription_prescription_order_action">
            <field name="name">Prescription Order</field>
            <field name="res_model">prescription.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="view_id" ref="prescription_prescription_order_list_view"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first
                </p>
            </field>
        </record>
        <menuitem id="prescription_prescription_order_menu_action" action="prescription_prescription_order_action" name="Prescription Order" parent="prescription_top_menu_prescription" sequence="1"/>
    </data>
</odoo>
