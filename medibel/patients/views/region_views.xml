<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="region_form_view_herited" model="ir.ui.view">
        <field name="name">Patients in the region</field>
        <field name="model">region.region</field>
        <field name="inherit_id" ref="ibel_location.region_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
               <button name="get_patient_ids_action" type="object" icon="fa-user" class="oe_stat_button" >
                   <field name="patient_ids_count" widget="statinfo" string="Patients"/>
               </button>
            </xpath>
        </field>
    </record>
</odoo>



