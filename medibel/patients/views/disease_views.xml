<odoo>
    <data>
        <record model="ir.ui.view" id="patient_disease_form_view">
            <field name="name">patient.disease.form</field>
            <field name="model">patient.disease</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <group string="Principal">
                            <field name="pathology_id"/>                                     
                            <field name="diagnosis_date"/>
                            <field name="age" />
                            <field name="doctor_id"/> 
                            <field name="patient_id"/>                                         
                        </group>
                        <group>
                            <field name="extra_info"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="patient_disease_tree_view">
            <field name="name">patient.disease.tree</field>
            <field name="model">patient.disease</field>
            <field name="arch" type="xml">
                <list string="Maladies">
                    <field name="patient_id"/> 
                    <field name="pathology_id"/>     
                    <field name="diagnosis_date"/>   
                    <field name="age" />
                    <field name="doctor_id" />
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="patient_disease_search_view">
            <field name="name">patient.disease.search</field>
            <field name="model">patient.disease</field>
            <field name="arch" type="xml">
                <search>
                    <field name="patient_id"/>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="patient_disease_action">
            <field name="name">Maladies</field>
            <field name="res_model">patient.disease</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="search_view_id" ref="patient_disease_search_view"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first
                </p>
            </field>
        </record>
    </data>
</odoo>
