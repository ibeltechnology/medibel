<odoo>
  <record id="view_partner_form_medical_base_fields" model="ir.ui.view">
    <field name="name">res.partner.form.medical.base.fields</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="inside">
        <group>
          <field name="is_patient" invisible="is_company"/>
          <field name="is_physician" invisible="is_company"/>
          <field name="specialty_id" invisible="is_company or not is_physician"/>
        </group>  
      </xpath>
    </field>
  </record>

  <record id="view_partner_form_medical_base_tab" model="ir.ui.view">
    <field name="name">res.partner.form.medical.base.tab</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page name="medical_hook_container" string="Medical Record" invisible="is_company or not is_patient" groups="patients.group_user,patients.group_manager">
          <h2> 
            <field name="age_range_id" invisible="not date_of_birth"/>
          </h2>
          <group string="Care Team" invisible="is_company or not is_patient">
            <field name="primary_physician_id" options="{'no_create_edit': True}"/>
            <field name="primary_physician_specialty_id" readonly="1"/>
          </group>
          <group string="Blood group and rhesus">
            <group>
              <field name="blood_group"/>
            </group>
            <group>
              <field name="rh_factor"/>
            </group> 
          </group>
          <group string="Ancestry">
            <group>
              <field name="mother_id"/>
            </group>
            <group>
              <field name="father_id"/>
            </group> 
          </group>
          <group string="Death">
            <group>
              <field name="deceased" />
              <field name="date_of_death" invisible="not deceased"/>  
            </group>
            <group>
              <field name="age_of_death" invisible="not deceased"/>   
              <field name="cause_of_death" invisible="not deceased"/>
            </group>
          </group>
          <separator/>
          <notebook>
              <page string="Diseases">
                <field name="patient_disease_ids"/>
              </page>
          </notebook>
          <separator string="Additional information" />
            <field name="extra_info"/>  
          <group string="Permissions">
            <group>
              <field name="company_id" />
            </group>
            <group>
              <field name="user_allowed_id"/>
            </group>
          </group> 
          <group string="Metadata">
            <group>
              <field name="create_date" />
              <field name="create_uid" />
            </group>
            <group>
              <field name="write_date" />
              <field name="write_uid" />
            </group>
          </group> 
        </page>
      </xpath>
    </field>
  </record>
</odoo>
