<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="medical_pathology_form_view" model="ir.ui.view">
            <field name="name">medical.pathology.form.view</field>
            <field name="model">medical.pathology</field>
            <field name="arch" type="xml">
                <form string="Pathology Info">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="uri" widget="url" readonly="1"/>
                            <field name="active" invisible="1" />
                            <field name="category_id" />
                            <field name="is_genetic" />
                        </group>
                        <group string="Genetics" invisible="not is_genetic">
                            <field name="chromosome" />
                            <field name="protein" />
                            <field name="gene" />
                        </group>                       
                        <group string="Extra Info">    
                            <field name="info" />
                        </group>
                    </sheet>    
                </form>
            </field>
        </record>

        <record id="medical_pathology_tree_view" model="ir.ui.view">
            <field name="name">medical.pathology.tree.view</field>
            <field name="model">medical.pathology</field>
            <field name="arch" type="xml">
                <list string="Pathology">
                    <field name="name" />
                    <field name="code" />
                    <field name="category_id" />
                </list>
            </field>
        </record>
        <record model="ir.ui.view" id="medical_pathology_search_view">
            <field name="name">medical.pathology.search.view</field>
            <field name="model">medical.pathology</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter name="by_catégory" string="Catégorie" context="{'group_by': 'category_id'}"/>
                </search>
            </field>
        </record>
        <record id="patient_pathology_action" model="ir.actions.act_window">
            <field name="name">Pathologies</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">medical.pathology</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">list,form,search</field>
        </record>

</odoo>
